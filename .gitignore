# Never commit these. A private key in a public repo is a compromised key.
*.pem
*.key
id_ed25519*
id_rsa*

# Terraform state records real infrastructure and can contain sensitive values.
.terraform/
.terraform.lock.hcl
*.tfstate
*.tfstate.*
*.tfvars
crash.log

# OS noise
Thumbs.db
.DS_Store
desktop.ini
